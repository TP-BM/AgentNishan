# --- Vexa (hosted) -----------------------------------------------------------
# Vexa's cloud issues ONE SCOPE PER KEY, so you need both. Create each in the
# dashboard under Create API Key -> Bot Key / Transcription Key.
#   Bot Key           (vxa_bot_…) sends bots into meetings
#   Transcription Key (vxa_tx_…)  reads what they transcribed
VEXA_BOT_API_KEY=vxa_bot_xxxxxxxxxxxxxxxxxxxx
VEXA_TX_API_KEY=vxa_tx_xxxxxxxxxxxxxxxxxxxx

# Managed cloud. For a self-hosted stack this is http://localhost:18056 instead.
VEXA_BASE_URL=https://api.cloud.vexa.ai
# Name the bot shows in the participant list. Make it obviously a notetaker.
VEXA_BOT_NAME=Nishan (Notetaker)
VEXA_LANGUAGE=en

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# --- Email -------------------------------------------------------------------
# MAILER=resend | smtp | none
MAILER=resend
NOTIFY_EMAIL=you@example.com

# resend: free tier sends from onboarding@resend.dev to your account address only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=onboarding@resend.dev

# smtp (alternative to resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# --- App ---------------------------------------------------------------------
# Shared-secret login. Anyone with this can spend your Vexa minutes — make it long.
APP_SECRET=change-me-to-something-long-and-random
PORT=3000
DATABASE_PATH=./data/meetnish.db

# Vexa leaves its bot in the call after a meeting ends, so "the transcript went
# quiet" is what actually ends a meeting. Polls of silence before finalising
# (default 6 x 20s = 2 min). Raise it if meetings go quiet for demos or long reads.
POLL_STALE_THRESHOLD=6

# Polls to wait for someone to admit the bot from the lobby before giving up
# (default 15 x 20s = 5 min). Too short abandons a meeting that starts late;
# too long leaves an unnoticed bot burning credits in a lobby.
POLL_ADMIT_THRESHOLD=15

# Voice command: someone says "<name>, leave the meeting" and the bot departs,
# then the digest is generated as usual. Include likely mishearings of the name
# — speech-to-text mangles proper nouns ("Nishan" often arrives as "Nissan").
# Leave LEAVE_COMMAND_NAMES empty to disable.
LEAVE_COMMAND_ENABLED=true
LEAVE_COMMAND_NAMES=nishan,nishaan,nishawn,nissan,nish
# Public base URL, used for links inside the digest email.
APP_BASE_URL=http://localhost:3000
